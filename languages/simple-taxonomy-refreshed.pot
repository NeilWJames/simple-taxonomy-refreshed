#: includes/class-simpletaxonomyrefreshed-admin-conversion.php:430
msgid "Phase One"
msgstr ""

#: includes/class-simpletaxonomyrefreshed-admin-conversion.php:431
#: includes/class-simpletaxonomyrefreshed-admin-import.php:320
