#!/bin/bash

# Regenerate the translation template with WP-CLI.
# Scans the PHP, the JS sources in src/ and the block.json files.
# The version in the POT header comes from the plugin header (Version:).

set -e

wp i18n make-pot . languages/simple-taxonomy-refreshed.pot \
  --slug=simple-taxonomy-refreshed \
  --domain=simple-taxonomy-refreshed \
  --exclude=bin,build,docs,images,languages,node_modules,script,tests,vendor
